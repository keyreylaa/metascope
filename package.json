{
  "name": "metascope",
  "version": "0.1.0",
  "description": "Photo/video metadata toolkit: read, edit, strip, provenance",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "metascope": "./dist/src/cli/index.js",
    "ms": "./dist/src/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "build": "tsc",
    "start": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "commander": "15.0.0",
    "discord.js": "14.27.0",
    "exiftool-vendored": "39.0.1",
    "tinyglobby": "0.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "files": [
    "dist/**"
  ]
}
